{
  "name": "testrina-portfolio",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node tools/build-site.mjs",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "test": "npm run format:check && npm run build && npm run validate",
    "validate": "node tools/validate-site.mjs dist",
    "format": "prettier --write \"**/*.{html,css,js,mjs,json,yml,yaml,md}\"",
    "format:check": "prettier --check \"**/*.{html,css,js,mjs,json,yml,yaml,md}\"",
    "sync:instagram": "node tools/sync-instagram.mjs"
  },
  "devDependencies": {
    "prettier": "3.9.6"
  },
  "engines": {
    "node": ">=18"
  }
}
